AI_BUILDER_TOKEN=your_token_here
# Legacy name also supported:
# SUPER_MIND_API_KEY=your_token_here

# Folder to index (Markdown + plain text). Override build_index --root if unset.
# NOTES_ROOT=/path/to/your/notes
